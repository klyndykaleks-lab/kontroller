+void HTTPClient::setOperationLimits(uint32_t operationTimeoutMs,
+                                    uint32_t responseHeaderTimeoutMs,
+                                    size_t maxResponseHeaderBytes,
+                                    uint32_t responseBodyTimeoutMs,
+                                    size_t maxResponseBodyBytes) {
+  _operationTimeoutMs = operationTimeoutMs;
+  _responseHeaderTimeoutMs = responseHeaderTimeoutMs;
+  _maxResponseHeaderBytes = maxResponseHeaderBytes;
+  _responseBodyTimeoutMs = responseBodyTimeoutMs;
+  _maxResponseBodyBytes = maxResponseBodyBytes;
+}
+
+uint32_t HTTPClient::boundedDeadline(uint32_t stageTimeoutMs) const {
+  const uint32_t stageDeadline = millis() + stageTimeoutMs;
+  if (_operationDeadlineMs != 0 &&
+      static_cast<int32_t>(_operationDeadlineMs - stageDeadline) < 0) {
+    return _operationDeadlineMs;
+  }
+  return stageDeadline;
+}
+
+int HTTPClient::readByteUntil(uint32_t deadlineMs) {
+  for (;;) {
+    if (static_cast<int32_t>(deadlineMs - millis()) <= 0) {
+      return HTTPC_ERROR_OPERATION_TIMEOUT;
+    }
+    if (!_client || !connected()) return HTTPC_ERROR_CONNECTION_LOST;
+    if (_client->available()) return _client->read();
+    delay(1);
   }
 }

+int HTTPClient::readLineUntil(String &line, uint32_t deadlineMs,
+                              size_t &totalBytes, size_t maxTotalBytes) {
+  line = String();
+  for (;;) {
+    const int value = readByteUntil(deadlineMs);
+    if (value < 0) return value;
+    if (++totalBytes > maxTotalBytes) return HTTPC_ERROR_RESPONSE_TOO_LARGE;
+    if (value == '\n') {
+      line.trim();
+      return 0;
+    }
+    line += static_cast<char>(value);
+  }
+}
