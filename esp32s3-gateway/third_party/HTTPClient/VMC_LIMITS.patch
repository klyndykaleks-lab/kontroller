+bool HTTPClient::getJsonBodyBounded(String &body) {
+  body = String();
+  if (!connected()) return false;
+  if (_size > 0 && static_cast<size_t>(_size) > _maxResponseBodyBytes) {
+    returnError(HTTPC_ERROR_RESPONSE_TOO_LARGE);
+    return false;
+  }
+
+  const uint32_t deadline =
+      boundedDeadline(_responseBodyTimeoutMs == 0
+                          ? _tcpTimeout
+                          : _responseBodyTimeoutMs);
+  bool jsonStarted = false;
+  bool inString = false;
+  bool escaped = false;
+  int depth = 0;
+  auto appendDecoded = [&](char value) {
+    if (body.length() >= _maxResponseBodyBytes) return false;
+    body += value;
+    if (!jsonStarted) {
+      if (value == '{' || value == '[') {
+        jsonStarted = true;
+        depth = 1;
+      }
+      return true;
+    }
+    if (inString) {
+      if (escaped) escaped = false;
+      else if (value == '\\') escaped = true;
+      else if (value == '"') inString = false;
+    } else if (value == '"') {
+      inString = true;
+    } else if (value == '{' || value == '[') {
+      ++depth;
+    } else if (value == '}' || value == ']') {
+      --depth;
+    }
+    return true;
+  };
+
+  if (_transferEncoding == HTTPC_TE_IDENTITY) {
+    int remaining = _size;
+    for (;;) {
+      if (remaining == 0) return jsonStarted && depth == 0 && !inString;
+      const int value = readByteUntil(deadline);
+      if (value < 0) {
+        returnError(value);
+        return false;
+      }
+      if (!appendDecoded(static_cast<char>(value))) {
+        returnError(HTTPC_ERROR_RESPONSE_TOO_LARGE);
+        return false;
+      }
+      if (remaining > 0) --remaining;
+      if (_size < 0 && jsonStarted && depth == 0 && !inString) {
+        // JSON gives unknown-length responses an unambiguous application frame.
+        _canReuse = false;
+        return true;
+      }
+    }
+  }
+
+  if (_transferEncoding != HTTPC_TE_CHUNKED) {
+    returnError(HTTPC_ERROR_ENCODING);
+    return false;
+  }
+
+  size_t framingBytes = 0;
+  for (;;) {
+    String chunkHeader;
+    const int lineResult =
+        readLineUntil(chunkHeader, deadline, framingBytes, 4096);
+    if (lineResult < 0) {
+      returnError(lineResult);
+      return false;
+    }
+    char *end = nullptr;
+    const unsigned long chunkLength = strtoul(chunkHeader.c_str(), &end, 16);
+    if (end == chunkHeader.c_str() ||
+        (*end != '\0' && *end != ';') ||
+        chunkLength > _maxResponseBodyBytes - body.length()) {
+      returnError(HTTPC_ERROR_RESPONSE_TOO_LARGE);
+      return false;
+    }
+    if (chunkLength == 0) {
+      // Consume bounded optional trailers through their terminating blank line.
+      do {
+        const int trailerResult =
+            readLineUntil(chunkHeader, deadline, framingBytes, 4096);
+        if (trailerResult < 0) {
+          returnError(trailerResult);
+          return false;
+        }
+      } while (chunkHeader.length() != 0);
+      return jsonStarted && depth == 0 && !inString;
+    }
+    for (unsigned long i = 0; i < chunkLength; ++i) {
+      const int value = readByteUntil(deadline);
+      if (value < 0 || !appendDecoded(static_cast<char>(value))) {
+        returnError(value < 0 ? value : HTTPC_ERROR_RESPONSE_TOO_LARGE);
+        return false;
+      }
+    }
+    const int cr = readByteUntil(deadline);
+    const int lf = readByteUntil(deadline);
+    if (cr != '\r' || lf != '\n') {
+      returnError(HTTPC_ERROR_READ_TIMEOUT);
+      return false;
+    }
+  }
 }

